# Flask Application Configuration
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
CRON_SECRET_KEY=replace-with-a-secure-cron-key-for-cronjobs-org
FLASK_ENV=development
PORT=3005

# Session Configuration
SESSION_LIFETIME_MINUTES=60

# Database Configuration (Optional: defaults to local SQLite instance/tickr.db if unset)
# For MySQL:
# DB_HOST=localhost
# DB_USER=tickr_user
# DB_PASS=tickr_password
# DB_NAME=tickr_db

# Or direct database URL:
# DATABASE_URL=mysql+mysqlconnector://tickr_user:tickr_password@localhost/tickr_db

# Superadmin Seed Configuration (Used by 'flask seed-admin')
SUPERADMIN_USER=superadmin
SUPERADMIN_PASS=admin123

# Network Whitelist (Optional comma-separated list of allowed IP addresses for GIA portal)
# IP_WHITELIST=127.0.0.1,localhost,172.16.255.237,172.16.255.236,172.16.254.255
# SPECIAL_USER_IDS=2024998
